{
  "name": "wp-theme-boilerplate",
  "version": "0.1.0",
  "description": "Wp theme boilerplate.",
  "license": "GPL-2.0-or-later",
  "type": "commonjs",
  "engines": {
    "node": ">=22.22.2"
  },
  "allowScripts": {
    "unrs-resolver": true,
    "@parcel/watcher": true,
    "core-js": false,
    "core-js-pure": false
  },
  "scripts": {
    "test": "vitest",
    "dev": "wp-scripts start",
    "build": "wp-scripts build",
    "archive:dist": "composer install --no-dev && wp-scripts build && wp-dev-tools archive --type dist && composer install",
    "archive:dev": "wp-dev-tools archive --type dev",
    "docker:shell": "docker exec -it wp-theme-boilerplate-wordpress /bin/bash",
    "docker:extract": "wp-dev-tools dockerExtract --container wp-theme-boilerplate-wordpress",
    "copy": "wp-dev-tools copy"
  },
  "devDependencies": {
    "vitest": "^5.0.2",
    "@stevekanger/wp-dev-tools": "^0.1.7",
    "@wordpress/scripts": "^36.0.0",
    "browser-sync-webpack-plugin": "^2.4.0",
    "dotenv": "^18.0.4",
    "typescript": "^6.0.3"
  }
}
